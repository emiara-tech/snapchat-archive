# Environment configuration is sensitive unless explicitly marked public.
# @defaultSensitive=true
# @defaultRequired=infer
# @generateTsTypes(path=src/env.d.ts)
# ---

# Optional key for explicitly authorized development and synthetic AI checks.
# Production inference must use the connected user's allowance.
# @sensitive
# @type=string(startsWith=sk-or-)
OPENROUTER_API_KEY=

# Server configuration. Optional for local archive features.
# @type=url
APP_ORIGIN=
# @sensitive
WORKOS_API_KEY=
# @sensitive
WORKOS_CLIENT_ID=
# @sensitive
# @type=string(minLength=32)
WORKOS_COOKIE_PASSWORD=
# @sensitive
# @type=url
UPSTASH_REDIS_REST_URL=
# @sensitive
UPSTASH_REDIS_REST_TOKEN=

# Optional persistent store for a single development server. Deployments require shared storage.
# @sensitive
LOCAL_AUTH_STORE=
